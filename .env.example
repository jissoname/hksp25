# ============================================================
# HKSP 本機／維運用環境變數（不要提交真實密鑰；前端靜態站不讀此檔）
# ============================================================

# PocketBase（正式後端）
PB_URL=https://db.keson.pro

# 超管：僅給 scripts/*.ps1 與本機維運使用（禁止寫進 pb-config.js／HTML）
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
PB_ADMIN_TOKEN=

# HKSP collections（社團評鑑；勿與助學金 hk_* 混用）
PB_COL_STAFF=hksp_staff
PB_COL_STUDENTS=hksp_students
PB_COL_ACTIVITIES=hksp_activities
PB_COL_CLUBS=hksp_clubs
PB_COL_MEMBERSHIPS=hksp_memberships
PB_COL_FOLDERS=hksp_folders
PB_COL_UPLOADS=hksp_uploads
PB_COL_SCORES=hksp_scores
PB_COL_AUDIT=hksp_audit_events
PB_ACTIVITY_ID=115-1-club-evaluation

# 前端公開設定在 pb-config.js：
# - usePocketBase=true
# - useDriveProxy=false（Drive 代傳非主路徑，預設關閉）
# - staffAdminEmail 僅預填登入 Email，不含密碼

# ------------------------------------------------------------
# Drive Proxy（已擱置／非上線主路徑；無需為正式站填寫）
# Google OAuth 密鑰若本機實驗，只放 backend/drive-proxy/.env
# ------------------------------------------------------------
DRIVE_PROXY_URL=
DRIVE_ENABLED=false
GOOGLE_HOLDER_EMAIL=
DRIVE_ROOT_FOLDER_ID=
